rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles collection (XP, HP, Gold, UPI ID, Level, Quests)
    match /profiles/{userId} {
      allow read, write: if true;
    }
    
    // Fallback for all Focus Quest documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
