rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles collection (XP, HP, Gold, UPI ID, Level)
    match /profiles/{userId} {
      // Allow read & write if user is authenticated and accessing their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default fallback rule for authenticated Focus Quest users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
